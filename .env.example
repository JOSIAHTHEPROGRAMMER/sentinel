
# Application URL
BETTER_AUTH_URL=http://localhost:3000

# Generate a unique secret for Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Neon PostgreSQL connection strings
# Use the pooled connection string for application queries.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Use the direct connection string for schema migrations.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
MONITOR_WORKER_DATABASE_URL=postgresql://WORKER_USER:PASSWORD@HOST/neondb?sslmode=verify-full